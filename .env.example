NODE_ENV=development
PORT=8787
DATABASE_PATH=.data/bridge.db
JWT_SECRET=dev-change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Local development may use *; production must set one explicit HTTPS origin.
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=120
TRUST_PROXY=false

# Push: dev (inbox only) | apns | both
PUSH_MODE=dev

# Real APNs (Apple Developer → Keys → Apple Push Notifications service)
# Download AuthKey_XXXXXXXXXX.p8, put under secrets/ (gitignored)
APNS_KEY_PATH=secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=hk.knockknock.app
# false = sandbox (Xcode debug builds); true = production
APNS_PRODUCTION=false
