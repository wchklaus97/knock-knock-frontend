{
  "name": "@vab/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice Agent Bridge MCP server and vab CLI",
  "bin": {
    "vab": "./dist/cli.js"
  },
  "scripts": {
    "postinstall": "node scripts/build-macos-deny-attach.mjs",
    "build:native": "node scripts/build-macos-deny-attach.mjs",
    "predev": "pnpm run build:native",
    "dev": "tsx src/index.ts",
    "prestart": "pnpm run build:native",
    "start": "tsx src/index.ts",
    "prebuild": "pnpm run build:native",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run build:native",
    "test": "tsx --test src/cli-support.test.ts src/listening.test.ts src/final-blockers.test.ts src/macos-anti-attach.test.ts",
    "test:paperclip": "tsx src/paperclip-smoke.ts",
    "precli": "pnpm run build:native",
    "cli": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
